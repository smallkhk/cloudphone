APP_NAME="Cloud Phone Reseller"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev/CI default is SQLite (zero config). For cPanel production, create a
# MySQL database + user in "MySQL® Databases" and switch to:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_DATABASE=cpuser_cloudphone   (cPanel prefixes db/user names)
#   DB_USERNAME=cpuser_dbuser
#   DB_PASSWORD=...
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- VMOS Cloud OpenAPI ---
# Get these from the VMOS console: Developer -> API.
VMOS_BASE_URL=https://api.vmoscloud.com
VMOS_ACCESS_KEY=
VMOS_SECRET_KEY=
# Set this in the VMOS console's callback URL field too:
#   https://your-domain.com/api/vmos/callback?token=<same value as below>
VMOS_CALLBACK_URL=
VMOS_WEBHOOK_TOKEN=

# --- Crypto payments (USDT / TRC20) ---
# The wallet address customers send USDT to. Payments are matched by tx hash
# against TronGrid, not by a unique address per order.
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
CRYPTO_PAYMENT_WINDOW_MINUTES=30
CRYPTO_AMOUNT_TOLERANCE_PERCENT=0.5
# Optional: raises TronGrid's public rate limit. Free at https://www.trongrid.io/
TRONGRID_API_KEY=

# --- AI live chat assistant (optional) ---
# Everything below is also editable at Admin -> Settings -> AI live chat.
# Replies are billed to your own Anthropic account, separately from any Claude
# subscription — set a spend limit at https://console.anthropic.com
ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Messages one visitor may send per hour, your cap against a runaway bill.
ASSISTANT_RATE_LIMIT=25

# Streaming gateway for the live screen (Web H5 SDK). NOT the OpenAPI host —
# the region varies by account, so confirm yours with VMOS if the screen won't
# connect while the rest of the API works.
VMOS_SDK_BASE_URL=https://openapi-hk.armcloud.net
