{
  "name": "vhonix",
  "version": "1.1.0",
  "description": "Vhonix desktop client",
  "main": "src/main.js",
  "author": "Vhonix",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallkhk/cloudphone.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "online.eclipselivecam.vhonix",
    "productName": "Vhonix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "smallkhk",
        "repo": "cloudphone",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
